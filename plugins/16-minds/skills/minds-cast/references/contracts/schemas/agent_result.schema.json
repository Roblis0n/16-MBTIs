{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://16minds.invalid/contracts/1.0.0/agent_result.schema.json",
  "title": "agent_result",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "action_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "result_revision": {
      "type": "integer",
      "minimum": 1
    },
    "input_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "persona_revision": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "claim.schema.json"
      }
    },
    "stance_change": {
      "type": "string",
      "enum": [
        "initial",
        "maintained",
        "partially_revised",
        "retracted"
      ]
    },
    "summary": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "score_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "subject_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "subject_version": {
            "type": "string"
          },
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "scale_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "value": {
            "type": "number"
          }
        },
        "required": [
          "actor_id",
          "subject_id",
          "subject_version",
          "criterion_id",
          "scale_id",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run_id",
    "actor_id",
    "round",
    "attempt_id",
    "action_id",
    "result_revision",
    "input_hash",
    "persona_revision",
    "claims",
    "stance_change",
    "summary",
    "limitations",
    "score_records"
  ],
  "additionalProperties": false
}
