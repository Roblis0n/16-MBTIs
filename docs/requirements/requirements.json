    {
      "id": "U01",
      "text": "把上传项目迁为 Codex plugin，保留可识别的原有功能与人格资产。",
      "type": "user"
    },
    {
      "id": "U02",
      "text": "审查逻辑漏洞、改进产品与工程质量，并考虑实际有用的新功能。",
      "type": "user"
    },
    {
      "id": "U03",
      "text": "新建议必须伴随调研，区分事实、设计判断、待验证假设。",
      "type": "user"
    },
    {
      "id": "U04",
      "text": "每项工作有极详计划，每阶段有可直接交给agent的提示词；控制范围、授权和验收；最终交付ZIP。",
      "type": "user"
    },
    {
      "id": "N01",
      "text": "证据式代码审查，把发现连接到定位/触发/复现/修复/测试。",
      "type": "proposed_feature"
    },
    {
      "id": "N02",
      "text": "事前验尸，连接失败路径、预警和预防措施。",
      "type": "proposed_feature"
    },
    {
      "id": "N03",
      "text": "决策翻转条件、敏感性检查、最小有效验证动作。",
      "type": "proposed_feature"
    },
    {
      "id": "N04",
      "text": "研究可行性压力测试，优先验证关键数据与交付约束。",
      "type": "proposed_feature"
    },
    {
      "id": "N05",
      "text": "本地opt-in决策记录和手动复盘，不假装后台提醒。",
      "type": "proposed_feature"
    },
    {
      "id": "N06",
      "text": "证据版本变动后的影响分析与保守增量重评。",
      "type": "proposed_feature"
    },
    {
      "id": "N07",
      "text": "可组合任务模板与无人格对照模式，不增加入口负担。",
      "type": "proposed_feature"
    },
    {
      "id": "N08",
      "text": "公平对照、预算与效果实测、可失效的校准和勘误链。",
      "type": "proposed_feature"
    },
    {
      "id": "N09",
      "text": "可选独立skills/Claude导出，不以多宿主需求阻塞核心。",
      "type": "proposed_feature"
    },
    {
      "id": "N10",
      "text": "可选多模型实验，额外接口、数据外发和预算单独审批。",
      "type": "proposed_feature"
    }
  ],
